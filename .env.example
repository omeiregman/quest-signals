# Odds data provider: theoddsapi | oddspapi | mock (blank keys => mock, no key needed)
ODDS_PROVIDER=theoddsapi
ODDS_API_KEY=
# OddsPapi (api.oddspapi.io) — carries 7bet.lt + betsson (Lithuania), sportybet + msport
# (Nigeria), pinnacle. Free tier 250 req/mo, pre-match only.
ODDSPAPI_API_KEY=
# Polling — seconds between background polls. 43200 = 2x/day; one OddsPapi soccer poll
# ≈ 4 requests, so 2x/day ≈ 240 req/mo (just inside the 250 free tier).
POLL_INTERVAL_SECONDS=43200
# SPORTS are provider-specific: The Odds API uses keys like soccer_fifa_world_cup,
# basketball_nba; OddsPapi uses soccer, basketball, tennis, baseball, ice-hockey,
# american-football. Each OddsPapi sport ≈ 4 requests/poll (free tier = 250/mo).
SPORTS=soccer_fifa_world_cup
REGIONS=eu
# OddsPapi tournament pinning: ids BOTH fundable books quote (arbs need both on a match).
# Empty = busiest-first discovery, capped at ODDSPAPI_MAX_TOURNAMENTS.
ODDSPAPI_TOURNAMENTS=
ODDSPAPI_MAX_TOURNAMENTS=5
# Telegram notifications for new arbs + value bets >= NOTIFY_MIN_VALUE_EDGE.
# Both blank = disabled. Create a bot via @BotFather; get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_VALUE_EDGE=0.03
# Detection thresholds
MIN_ARB_MARGIN=0.01
MIN_VALUE_EDGE=0.02
# Ignore book offers priced above this (longshot/stale-price artifacts). 0 = no cap.
MAX_LEG_ODDS=0
# Skip events starting within this many minutes (and in-play). 0 = off.
MIN_TIME_TO_EVENT_MINUTES=0
# Ignore book prices whose feed timestamp is older than this many hours (stale-line guard;
# stale soft-book lines are the main source of phantom arbs/value). 0 = off.
MAX_PRICE_AGE_HOURS=48
# Money realism
TAX_RATE=0.20
DEFAULT_BANKROLL=100
# Stake rounding increment. Keep small (0.1): coarse rounding eats thin arb margins.
STAKE_ROUNDING=0.1
# Server
PORT=8787
DATABASE_URL=./data/quest.sqlite
